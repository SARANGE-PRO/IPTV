# =============================================================================
#  Variables d'environnement — IPTV PWA
#  Copier en `.env.local` (jamais commit). Ne prefixer par NEXT_PUBLIC_ que ce
#  qui peut etre expose au client. Les cles sensibles restent cote serveur.
# =============================================================================

# TMDB — utilise UNIQUEMENT cote serveur (Route Handler /api/tmdb). Etape 9.
# Jamais NEXT_PUBLIC_. Ne jamais appeler TMDB directement depuis le client.
# Sert aussi au rail « Tendances » (/api/trending, trending TMDB de la semaine).
TMDB_API_KEY=

# Football-data.org — OPTIONNEL : secours des matchs si l'API ESPN ne repond pas
# (12 competitions du palier gratuit). Cle : https://www.football-data.org/client/register
# Cote SERVEUR uniquement (jamais NEXT_PUBLIC_), lue par /api/football.
FOOTBALL_API_KEY=

# Passerelle media auto-hebergee : transcode les MKV/AVI en fMP4 lisible sur
# iPhone/iPad, et sert de relais HTTPS pour un Xtream HTTP-only (mixed-content).
# Exemple : https://media.example.com (sans slash final). Voir infra/media-gateway.
# NB : les images ne passent JAMAIS par ce relais (secureImageSrc).
#
# Il SUFFIT de renseigner cette URL : l'app sonde /_health a la demande et
# n'active le transcodage MKV in-app QUE si la passerelle repond ; sinon elle
# bascule proprement vers VLC. (L'ancien flag NEXT_PUBLIC_MEDIA_GATEWAY_TRANSCODE
# n'est plus lu ni necessaire.)
NEXT_PUBLIC_MEDIA_GATEWAY_URL=

# Coquille HTTP PURE (infra/http-shell) — variables de BUILD, jamais sur Vercel.
# NEXT_PUBLIC_PLAIN_HTTP=1 : la page est servie en HTTP -> aucun mixed-content,
# flux video lus en DIRECT sans passerelle (MP4/HLS), logos HTTP non upgrades,
# CSP sans upgrade-insecure-requests. NEXT_OUTPUT=standalone : serveur Docker.
# Le Dockerfile les fixe lui-meme ; ne les definir ici qu'en test local.
# NEXT_PUBLIC_PLAIN_HTTP=
# NEXT_OUTPUT=

# Coquille STATIQUE (GitHub Pages, `npm run build:static`) : pas de serveur, les
# routes /api/* restent sur Vercel. Cote coquille (variable de BUILD, dans les
# Variables GitHub Actions) :
# NEXT_PUBLIC_API_BASE_URL=https://<app>.vercel.app
# Cote VERCEL (variable de BUILD) : l'origine HTTP de la coquille, une seule,
# jamais `*` (le proxy relaie des identifiants). Vide = pas de CORS.
# CORS_ALLOWED_ORIGIN=http://tv.exemple.fr
# Cote VERCEL (serveur) : restreint le proxy /api/xtream a TES serveurs Xtream
# (hotes separes par des virgules, sans schema ni port). Vide = tout hote public.
# XTREAM_ALLOWED_HOSTS=exemple.com,backup.exemple.com

# Football (header d'accueil + page Football) — AUCUNE cle requise :
#  - matchs/scores en direct : API publique ESPN (toutes competitions) ;
#  - chaine TV FR de chaque match : guide XMLTV public xmltvfr.fr, lu en flux
#    cote serveur et mis en cache 3 h (Vercel Cron /api/football?warm=1).
# FOOTBALL_TV_GUIDE_URL ne sert qu'a SURCHARGER le guide (URL(s) XMLTV, .gz
# accepte, separees par des virgules). Cote SERVEUR uniquement.
# FOOTBALL_API_KEY (plus haut) devient un simple SECOURS si ESPN ne repond pas.
FOOTBALL_TV_GUIDE_URL=
ttps://iptv-org.github.io/epg/guides/fr/telerama.fr.epg.xml
SPORT_EPG_URL=

# --- Notes ---
# Les identifiants Xtream ne sont PAS des variables d'env : ils sont saisis
# dans l'interface de connexion puis stockes localement (secureSessionService).
