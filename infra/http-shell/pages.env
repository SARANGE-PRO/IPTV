# Valeurs de BUILD de la coquille statique GitHub Pages (lues par
# .github/workflows/pages.yml). Rien de secret ici : tout finit dans le bundle
# client de toute facon. Les cles serveur (TMDB, foot) restent sur Vercel.

# Origine des routes /api/* (deploiement Vercel de production, sans slash final).
NEXT_PUBLIC_API_BASE_URL=https://iptv-zib.vercel.app

# Domaine HTTP de la coquille (ecrit dans out/CNAME, lu par GitHub Pages).
# Doit etre IDENTIQUE a CORS_ALLOWED_ORIGIN sur Vercel (prefixe http://).
PAGES_CUSTOM_DOMAIN=zibtv.duckdns.org

# Optionnel : passerelle de transcodage MKV (URL Tailscale Funnel, https://…).
# Vide = les MKV s'ouvrent dans VLC.
NEXT_PUBLIC_MEDIA_GATEWAY_URL=
